---
import Layout from '../layouts/Layout.astro'
import Scene from '../components/Scene.tsx'
import { site } from '../data/site'
import { books, films, records } from '../data/collections'
import { resolveFilms } from '../data/tmdb'
import { resolveBooks } from '../data/openLibrary'

// Resolved here rather than in the browser so the TMDB key stays server-side
// and the room costs no metadata requests at runtime. Neither throws: with no
// key or no network they return nulls and the shelves fall back to plain
// coloured covers.
const [resolvedFilms, resolvedBooks] = await Promise.all([
	resolveFilms(films),
	resolveBooks(books),
])

const shelves = [
	{ heading: 'Reading', items: books },
	{ heading: 'Listening', items: records },
	{ heading: 'Watching', items: films },
]
---

<Layout>
	<header class="masthead">
		<h1>{site.name}</h1>
		<p>{site.tagline}</p>
	</header>

	<div id="scene">
		<Scene client:only="react" films={resolvedFilms} books={resolvedBooks} />
	</div>

	<!--
		The room is the interface, but everything in it is real content. This
		mirror keeps the page meaningful to search engines, screen readers, and
		anyone without WebGL.
	-->
	<section class="sr-only" aria-label="Site contents">
		<p>This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
		<p>Book covers and details come from <a href="https://openlibrary.org">Open Library</a>.</p>
		<h2>Links</h2>
		<ul>
			{site.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
		</ul>
		{
			shelves.map((shelf) => (
				<>
					<h2>{shelf.heading}</h2>
					<ul>
						{shelf.items.map((item) => (
							<li>{item.title} — {item.by}</li>
						))}
					</ul>
				</>
			))
		}
	</section>
</Layout>
